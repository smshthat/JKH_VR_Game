  m_Script: {fileID: 11500000, guid: 480a0e06e437ecb4c9e0e7187a7cccbf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  talkLines:
  - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!"
  - "\u0414\u0435\u043D\u044C\u0433\u0438 \u0437\u0430 \u0416\u041A\u0425 \u044F
    \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B."
  - "\u041A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u044E \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435
    \u043D\u0430 \u0441\u0442\u043E\u043B."
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0437\u0430\u0448\u043B\u0438."
  hitLines:
  - "\u0410\u0439! \u041D\u0435 \u0431\u0435\u0439\u0442\u0435!"
